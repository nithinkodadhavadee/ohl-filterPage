{"outcome":"success","item-info":"\n  <div class=\"item-dv details-view\" data-join-id=\"167806446\">\n\n    <!-- Item Header -->\n    <div class=\"item-header item-edit-menu\">\n\n      <ul class=\"item-edit-menu-wrapper menu\" tabindex=\"-1\">\n\n                  <li><a href=\"#\" class=\"item-hold-button\" data-join-id=\"167806446\">Add Hold<\/a><\/li>\n                        <li><a href=\"#\" class=\"item-copy-button\" data-copy-message=\"Copied\" data-join-id=\"167806446\">Copy Link<\/a><\/li>\n      <\/ul>\n\n      <div class=\"close close-item\"><\/div>\n    <\/div>\n\n  <div class=\"summary-left-col\"><div class=\"cover-wrapper\" data-join-id=\"167806446\"><img src=\"https:\/\/d23tvywehq0xq.cloudfront.net\/bdf8c6d9c40237c0ca934c56f5c16f66f6.jpg\" data-join-id=\"167806446\" alt=\"Abundance\"><div class=\"expand-img\"><\/div><\/div><div class=\"item-library show-mobile\">Books<\/div><span class=\"media-tag show-mobile\">Book<\/span><div class=\"item-title show-mobile\" data-join-id=\"167806446\">Abundance<\/div><div class=\"item-author show-mobile\">Peter H. Diamandis, Steven Kotler<\/div><div class=\"item-ensemble show-mobile\"><\/div><\/div><div class=\"summary-right-col\"><div class=\"item-library hide-mobile\">Books<\/div><span class=\"media-tag hide-mobile\">Book<\/span><div class=\"item-title hide-mobile\" data-join-id=\"167806446\">Abundance<\/div><div class=\"item-author hide-mobile\">Peter H. Diamandis, Steven Kotler<\/div><div class=\"item-ensemble hide-mobile\"><\/div><div><span class=\"meta\"><strong>2014<\/strong><\/span><span class=\"meta\">412 pages<\/span><span class=\"meta\">(Simon and Schuster)<\/span><\/div><div><\/div><div><\/div><div class=\"margin-bottom-10\"><\/div><div class=\"available margin-top-10 margin-bottom-10\"><span class=\"meta\"><strong>Copies:<\/strong> <span class=\"details-copy-count\">1<\/span><\/span><span class=\"meta\"><strong>Out:<\/strong> 0<\/span><span class=\"meta\"><strong>Holds:<\/strong> 0<\/span><\/div><div class=\"item-tags margin-top-20\" data-copy-message=\"Copied\"><span>nonfiction<\/span><\/div><ul class=\"admin-tabs menu item-details-menu margin-top-20\"><li class=\"active\"><a href=\"#\">Description<\/a><\/li><\/ul><div data-tab=\"Description\" class=\"item-description margin-top-10 tab-item\">The New York Times bestselling \u201cmanifesto for the future that is grounded in practical solutions addressing the world\u2019s most pressing concerns: overpopulation, food, water, energy, education, health care and freedom\u201d (The Wall Street Journal).Since the dawn of humanity, a privileged few have lived in stark contrast to the hardscrabble majority. Conventional wisdom says this gap cannot be closed. But it is closing\u2014and fast. In Abundance, space entrepreneur turned innovation pioneer Peter H. Diamandis and award-winning science writer Steven Kotler document how progress in artificial intelligence, robotics, digital manufacturing synthetic biology, and other exponentially growing technologies will enable us to make greater gains in the next two decades than we have in the previous 200 years. We will soon have the ability to meet and exceed the basic needs of every person on the planet. Abundance for all is within our grasp. Breaking down human needs by category\u2014water, food, energy, healthcare, education, freedom\u2014Diamandis and Kotler introduce us to innovators and industry captains making tremendous strides in each area. \u201cNot only is Abundance a riveting page-turner\u2026but it\u2019s a book that gives us a future worth fighting for\u201d (The Christian Science Monitor).<\/div><p>&nbsp;<\/p><\/div>\n<\/div>\n\n\n<script>\n  $(document).ready(function() {\n\n    var detail = $('#item-details-view');\n\n    function closeItem() {\n      var join_id = $('#item-details-info .item-dv.details-view').data('join-id');\n      $('.item[data-join-id=\"' + join_id + '\"] img, .item-title[data-join-id=\"' + join_id + '\"]').focus();\n\n\n\n      detail.removeClass('open');\n\n      setTimeout(function() {\n        $('#item-details-info').empty();\n      }, 500);\n\n      $('#primary').removeClass('noscroll');\n      $('div.loading-icon').remove();\n      $('.close-item').fadeOut(200);\n    }\n\n    \/\/ close detail view\n    $('.close-item').on('click', function(e) {\n      if (e.originalEvent.detail > 1) {\n        return;\n      }\n      history.back();\n      return false;\n    });\n\n    \/\/ Close detail view (or edit view) on escape (unbind and rebind to prevent pile-up)\n    $(document).off('keyup.close').on('keyup.close', function(e) {\n\n      \/\/ If escape key, and there is no notification overlay, and filter\/basket is already closed, and edit items is open\n      if (e.which == 27\n          && $('#img-overlay.item-img').css('display') != 'none'\n          && !$('#overlay').length\n          && !$('#filter-sidebar').hasClass('filter-open')\n          && !$('#basket-sidebar').hasClass('basket-open')) {\n        closeImgOverlay();\n      }\n      else if (e.which == 27\n          && detail.hasClass('open')\n          && !$('#overlay').length\n          && $('#item-details-info .item-header').length\n          && !$('#filter-sidebar').hasClass('filter-open')\n          && !$('#basket-sidebar').hasClass('basket-open')) {\n        \/\/ #item-details-info .item-header is to make sure item has loaded before we remove history\n        \/\/ Otherwise popstate isn't triggered and we get into history state issues\n        history.back();\n        return false;\n      }\n\n    });\n\n    $(window).one('popstate', function(){\n      closeItem();\n    });\n\n    \/\/ handle item details tabs\n    var itemDetailsMenu = $('.item-details-menu a');\n    var itemDetailsMenu2 = $('.item-details-menu-2 a');\n    var tabItem = $('.tab-item');\n    var tabItem2 = $('.tab-item2');\n\n    itemDetailsMenu.on('click', function() {\n      itemDetailsMenu.parent().removeClass('active');\n      $(this).parent().addClass('active');\n      var tabSelect = $(this).text();\n      tabItem.hide();\n      $('div[data-tab=\"' + tabSelect +'\"]').show();\n\n      return false;\n    });\n\n    itemDetailsMenu2.on('click', function() {\n      itemDetailsMenu2.parent().removeClass('active');\n      $(this).parent().addClass('active');\n      var tabSelect = $(this).text();\n      tabItem2.hide();\n      $('div[data-tab=\"' + tabSelect +'\"]').show();\n\n      return false;\n    });\n\n    var img_overlay = $('#img-overlay.item-img');\n    var overlay_title = $('.overlay-title');\n    var overlay_creator = $('.overlay-creator');\n\n    function closeImgOverlay() {\n      img_overlay.hide();\n      $('#img-overlay.item-img img').attr('src', '');\n      overlay_title.text('');\n      overlay_creator.text('');\n      $('#item-details-view .cover-wrapper img').removeClass('active');\n    }\n\n    \/\/ display full screen\n    $('body').on('click', '#item-details-view .cover-wrapper:not(.missing-img) img', function() {\n      var src = $(this).attr('src');\n      $(this).addClass('active');\n      $('#img-overlay.item-img img').attr('src', src);\n      img_overlay.show();\n      var title = $('#item-details-view .item-title.hide-mobile').text();\n      var creator = $('#item-details-view .item-author.hide-mobile').text();\n      overlay_title.text(title);\n      overlay_creator.text(creator);\n    });\n    $('body').on('click', '.expand-img:first', function() {\n      var src = $(this).prev('img').attr('src');\n      $(this).prev('img').addClass('active');\n      $('#img-overlay.item-img img').attr('src', src);\n      img_overlay.show();\n      var title = $('#item-details-view .item-title.hide-mobile').text();\n      var creator = $('#item-details-view .item-author.hide-mobile').text();\n      overlay_title.text(title);\n      overlay_creator.text(creator);\n    });\n\n\n    $('.img-overlay-close').on('click', function() {\n      closeImgOverlay();\n      return false;\n    });\n\n  });\n<\/script>"}