# Copy this file to `.env` for local development. `.env` is git-ignored.
#
# Local development works against the first 50 titles from A onward. Leave
# SAMPLE_SIZE unset (or set it to 0) in production to use the whole visible
# Collection. See docs/operations.md for every setting.
SAMPLE_SIZE=50

# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=3000
# CYCLE_DELAY_SECONDS=30
# CRAWLER_ENABLED=true
# ENRICH_COOLDOWN_SECONDS=3600
# CATALOGUE_SCAN_INTERVAL_SECONDS=86400
# SNAPSHOT_RETAIN=10
# LIBIB_REQUEST_DELAY_MS=1000
# ENRICH_REQUEST_DELAY_MS=1000
# LIBIB_BASE_URL=https://www.libib.com/u/openhouselibrary
# LIBIB_LIBRARY_ID=2677037
