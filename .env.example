# Environment template for the Open House Library Discovery page.
#
# Local development
# -----------------
# Copy this file to `.env.local` (git-ignored). `npm run dev` and every CLI
# script load `.env` first and then `.env.local`, so local settings win.
# For a local Sample, set this in `.env.local`:
#
#   SAMPLE_SIZE=50
#
# Docker Compose and production
# -----------------------------
# Compose reads `.env` in this directory and passes those values into the
# container. Keep `SAMPLE_SIZE=0` (or omit it) in `.env` so production scans the
# whole visible Collection. Set a positive value only when you deliberately
# want a capped Crawl set. Compose never reads `.env.local`.
SAMPLE_SIZE=0

# The remaining settings are optional; their defaults are shown.
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=3000
# CYCLE_DELAY_SECONDS=30
# CRAWLER_ENABLED=true
# ENRICH_COOLDOWN_SECONDS=3600
# CATALOGUE_SCAN_INTERVAL_SECONDS=86400
# SNAPSHOT_RETAIN=10
# ANALYTICS_RETENTION_DAYS=0
# LIBIB_REQUEST_DELAY_MS=1000
# ENRICH_REQUEST_DELAY_MS=1000
# LIBIB_BASE_URL=https://www.libib.com/u/openhouselibrary
# LIBIB_LIBRARY_ID=2677037
