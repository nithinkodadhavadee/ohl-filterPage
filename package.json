{
  "name": "open-house-library-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only discovery page over the Open House Library Libib catalogue",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:ui": "vite",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "seed": "node scripts/run-cli.mjs src/server/seed.ts dist/server/seed.js",
    "catalogue:scan": "node scripts/run-cli.mjs src/server/index-cli.ts dist/server/index-cli.js scan",
    "catalogue:resample": "node scripts/run-cli.mjs src/server/index-cli.ts dist/server/index-cli.js resample",
    "sweep": "node scripts/run-cli.mjs src/server/refresh-cli.ts dist/server/refresh-cli.js",
    "enrich": "node scripts/run-cli.mjs src/server/enrich-cli.ts dist/server/enrich-cli.js",
    "overrides:import": "node scripts/run-cli.mjs src/server/override-cli.ts dist/server/override-cli.js",
    "export:unmatched": "node scripts/run-cli.mjs src/server/export-unmatched-cli.ts dist/server/export-unmatched-cli.js",
    "snapshot": "node scripts/run-cli.mjs src/server/snapshot-cli.ts dist/server/snapshot-cli.js snapshot",
    "restore": "node scripts/run-cli.mjs src/server/snapshot-cli.ts dist/server/snapshot-cli.js restore",
    "export": "node scripts/run-cli.mjs src/server/snapshot-cli.ts dist/server/snapshot-cli.js export",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
